# StampFly workshop — Default SDK Configuration
# StampFly workshop — デフォルトSDK設定
#
# Same settings as firmware/vehicle/sdkconfig.defaults (workshop rebuilt on
# the vehicle component base, R12 / workshop_migration.md M5).
# firmware/vehicle/sdkconfig.defaults と同一設定（workshop は vehicle
# コンポーネント基盤上に再構築、R12 / workshop_migration.md M5）。

# Target: ESP32-S3 (M5Stamp S3)
CONFIG_IDF_TARGET="esp32s3"

# Flash size (8MB)
# フラッシュサイズ（8MB）
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Custom partition table
# カスタムパーティションテーブル
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS: 1kHz tick, dual core
# FreeRTOS: 1kHzティック、デュアルコア
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# CPU frequency: 240MHz
# CPU周波数: 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# USB console on the built-in USB Serial/JTAG controller (hardware CDC).
# Chosen so the cable can be plugged in after the craft has booted on
# battery (hardware enumeration). The USB-OTG CDC console used before could
# not be reached in that order (2026-10-15).
# USB コンソールはチップ内蔵の USB Serial/JTAG（ハードウェア CDC）を使う。
# 電池で起動した後にケーブルを挿しても通信できるようにするため（列挙をハードウェアが行う）。以前の
# USB-OTG CDC コンソールは、電池起動後に挿すと通信できなかった（2026-10-15）。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Log level
# ログレベル
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Watchdog timeout
# ウォッチドッグタイムアウト
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# System event task stack (WiFi requires larger stack)
# システムイベントタスクスタック（WiFi用に拡大）
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# WiFi for ESP-NOW and telemetry
# WiFi（ESP-NOWおよびテレメトリ用）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_IRAM_OPT=y

# NVS for parameter persistence
# NVS（パラメータ永続化用）
CONFIG_NVS_DEFAULT_PART_SIZE=0x6000

# SPI (IMU, OptFlow)
CONFIG_SPI_MASTER_IN_IRAM=y

# I2C (ToF, Mag, Baro, Power)
CONFIG_I2C_ISR_IRAM_SAFE=y

# GPIO
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# LEDC PWM (Motors)
# LEDC PWM（モーター用）
CONFIG_LEDC_CTRL_FUNC_IN_IRAM=y

# RMT (WS2812 LED)
CONFIG_RMT_ISR_IRAM_SAFE=y

# C++ exceptions (required by some sensor drivers)
# C++例外（一部センサドライバで必要）
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Compiler optimization: -O2 (PERF). The default -Og leaves the ESKF's dense
# 15x15 covariance math (~10k MAC/cycle at 400Hz) unoptimized — measured on
# hardware it saturates core 1 and starves StateTask (INIT-stuck bug).
# コンパイラ最適化: -O2 (PERF)。既定の -Og は ESKF の密 15x15 共分散演算
# （400Hz で ~1万積和/周期）を未最適化のまま残し、実機計測でコア1を飽和させ
# StateTask を飢餓させた（INIT 停止バグ）。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
