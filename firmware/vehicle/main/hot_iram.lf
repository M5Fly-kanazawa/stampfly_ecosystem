# Experiment: place the code that runs every 400 Hz cycle in IRAM (internal RAM)
# instead of flash (read through the 16 KB shared instruction cache).
# Enabled only when the build is given -D SF_EXP_HOT_IRAM=1 (see main/CMakeLists.txt);
# without it this file is not passed to the linker-script generator at all.
# Only .text (code, and the literal pools inside it) moves ("noflash_text");
# .rodata (constant tables, strings) stays in flash, behind the separate data cache.

[mapping:sf_hot_main]
archive: libmain.a
entries:
    imu_task (noflash_text)

[mapping:sf_hot_eskf]
archive: libsf_estimator_eskf.a
entries:
    * (noflash_text)

