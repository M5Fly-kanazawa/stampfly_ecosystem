# Place the code that runs every 400 Hz cycle (ImuTask and the ESKF) in IRAM
# (internal RAM) instead of flash. Flash code is read through the instruction
# cache; with the cache too small, the 400 Hz path keeps being evicted and the
# processing time of one ImuTask cycle grows. Evidence: docs/hardware/mcu-memory.md chapters 7 and 8.
# Only .text (code, and the literal pools inside it) moves ("noflash_text");
# .rodata (constant tables, strings) stays in flash, behind the separate data cache.
# This costs about 19 KB of IRAM. Before adding more targets here, measure the
# free heap again: IRAM taken here is not available to the heap.
# Keep this file ASCII only: ldgen opens linker fragments with the default
# encoding of the platform, so non-ASCII text can stop a build on Windows.
# The Japanese explanation is in main/CMakeLists.txt (LDFRAGMENTS).

[mapping:sf_hot_main]
archive: libmain.a
entries:
    imu_task (noflash_text)

[mapping:sf_hot_eskf]
archive: libsf_estimator_eskf.a
entries:
    * (noflash_text)
