/**
 * @file params.def
 * @brief Parameter definitions — single location for all tunable parameters
 *        パラメータ定義 — 全チューニングパラメータの定義（1箇所）
 *
 * Adding a parameter: add one PARAM_FLOAT/PARAM_BOOL/PARAM_INT line here.
 * パラメータ追加: ここにPARAM_FLOAT/PARAM_BOOL/PARAM_INT行を1行追加する。
 *
 * Format: PARAM_TYPE("name", default, min, max, callback)
 *
 * @design requirements.md §3 — 3-level naming: function.target.param  [--]
 * @design detailed_design.md §6 — Single-macro parameter definition   [--]
 */

// =============================================================================
// Rate Control (inner loop) — レート制御（内ループ）
// =============================================================================

PARAM_FLOAT("rate.roll.kp",    1.365e-3f, 0.0f,  0.1f,   nullptr)
PARAM_FLOAT("rate.roll.ti",    0.7f,      0.01f, 100.0f, nullptr)
PARAM_FLOAT("rate.roll.td",    0.01f,     0.0f,  1.0f,   nullptr)
PARAM_FLOAT("rate.pitch.kp",   1.995e-3f, 0.0f,  0.1f,   nullptr)
PARAM_FLOAT("rate.pitch.ti",   0.7f,      0.01f, 100.0f, nullptr)
PARAM_FLOAT("rate.pitch.td",   0.01f,     0.0f,  1.0f,   nullptr)
PARAM_FLOAT("rate.yaw.kp",     5.31e-3f,  0.0f,  0.1f,   nullptr)
PARAM_FLOAT("rate.yaw.ti",     1.6f,      0.01f, 100.0f, nullptr)
PARAM_FLOAT("rate.yaw.td",     0.01f,     0.0f,  1.0f,   nullptr)

// =============================================================================
// Attitude Control (outer loop) — 姿勢制御（外ループ）
// =============================================================================

PARAM_FLOAT("attitude.roll.kp",  5.0f,  0.0f,  50.0f, nullptr)
PARAM_FLOAT("attitude.roll.ti",  4.0f,  0.01f, 100.0f, nullptr)
PARAM_FLOAT("attitude.roll.td",  0.04f, 0.0f,  1.0f,  nullptr)
PARAM_FLOAT("attitude.pitch.kp", 5.0f,  0.0f,  50.0f, nullptr)
PARAM_FLOAT("attitude.pitch.ti", 4.0f,  0.01f, 100.0f, nullptr)
PARAM_FLOAT("attitude.pitch.td", 0.04f, 0.0f,  1.0f,  nullptr)

// =============================================================================
// Altitude Control — 高度制御
// =============================================================================

PARAM_FLOAT("altitude.alt.kp",   0.6f,  0.0f, 10.0f,  nullptr)
PARAM_FLOAT("altitude.alt.ti",   7.0f,  0.1f, 100.0f, nullptr)
PARAM_FLOAT("altitude.vel.kp",   0.1f,  0.0f, 10.0f,  nullptr)
PARAM_FLOAT("altitude.vel.ti",   2.5f,  0.1f, 100.0f, nullptr)

// =============================================================================
// Position Control — 位置制御
// =============================================================================

PARAM_FLOAT("position.pos.kp",   1.0f,  0.0f, 10.0f,  nullptr)
PARAM_FLOAT("position.pos.ti",   5.0f,  0.1f, 100.0f, nullptr)
PARAM_FLOAT("position.vel.kp",   0.3f,  0.0f, 10.0f,  nullptr)
PARAM_FLOAT("position.vel.ti",   2.0f,  0.1f, 100.0f, nullptr)

// =============================================================================
// ESKF Process Noise — ESKFプロセスノイズ
// =============================================================================

PARAM_FLOAT("eskf.process.gyro_noise",    0.009655f, 0.001f, 1.0f,  nullptr)
PARAM_FLOAT("eskf.process.accel_noise",   0.3f,      0.01f,  10.0f, nullptr)
PARAM_FLOAT("eskf.process.gyro_bias",     0.000013f, 1e-7f,  0.01f, nullptr)
PARAM_FLOAT("eskf.process.accel_bias",    0.0001f,   1e-7f,  0.01f, nullptr)

// =============================================================================
// ESKF Observation Noise — ESKF観測ノイズ
// =============================================================================

PARAM_FLOAT("eskf.obs.tof_noise",      0.03f, 0.001f, 1.0f, nullptr)
PARAM_FLOAT("eskf.obs.flow_noise",     0.30f, 0.01f,  5.0f, nullptr)
PARAM_FLOAT("eskf.obs.baro_noise",     0.1f,  0.01f,  5.0f, nullptr)
PARAM_FLOAT("eskf.obs.mag_noise",      1.0f,  0.01f,  10.0f, nullptr)
PARAM_FLOAT("eskf.obs.accel_att_noise", 0.06f, 0.001f, 1.0f, nullptr)

// =============================================================================
// ESKF Sensor Enable — ESKFセンサ有効/無効
//
// @design detailed_design.md §5 — Sensor observation switch           [--]
// =============================================================================

PARAM_BOOL("eskf.use_tof",   true,  0, 1, nullptr)
PARAM_BOOL("eskf.use_flow",  true,  0, 1, nullptr)
PARAM_BOOL("eskf.use_baro",  false, 0, 1, nullptr)
PARAM_BOOL("eskf.use_mag",   false, 0, 1, nullptr)

// =============================================================================
// ESKF Gates — ESKFゲート閾値
// =============================================================================

PARAM_FLOAT("eskf.gate.mahalanobis",   15.0f, 1.0f, 100.0f, nullptr)
PARAM_FLOAT("eskf.gate.tof_innov",     0.5f,  0.01f, 5.0f,  nullptr)
PARAM_FLOAT("eskf.gate.baro_innov",    0.5f,  0.01f, 5.0f,  nullptr)
PARAM_FLOAT("eskf.gate.flow_clamp",    0.3f,  0.01f, 5.0f,  nullptr)

// =============================================================================
// Safety — 安全
// =============================================================================

PARAM_FLOAT("safety.impact.accel_g",    3.0f,  1.0f, 10.0f, nullptr)
PARAM_FLOAT("safety.impact.gyro_dps",   800.0f, 100.0f, 2000.0f, nullptr)
PARAM_FLOAT("safety.comm.timeout_ms",   500.0f, 100.0f, 5000.0f, nullptr)
PARAM_FLOAT("safety.battery.low_v",     3.4f,  3.0f, 4.2f,  nullptr)
PARAM_FLOAT("safety.battery.usb_v",     3.3f,  2.5f, 3.5f,  nullptr)

// =============================================================================
// Calibration — キャリブレーション
//
// @design detailed_design.md §3 — onEnter(IDLE): start calibration    [--]
// =============================================================================

// Boot gyro/accel bias calibration on/off. When true, ImuTask measures the IMU
// bias at rest on the ground and seeds the estimator with it before flight. Off
// is used by the SIL contrast test to show the estimator degrading without it.
// 起動時のジャイロ/加速度バイアス校正の ON/OFF。true で ImuTask が地上静止時に IMU
// バイアスを測り、飛行前に推定器へ種付けする。OFF は SIL 対照テストで「校正なしだと
// 推定器が劣化する」ことを示すのに使う。
PARAM_BOOL("calibration.enable", true, 0, 1, nullptr)
