 static float thrustToDuty(float thrust, float vbat)
 {
+    using namespace plant_inverse;
     if (thrust <= 0.0f) return MIN_DUTY;
-    const float omega = std::sqrt(thrust / MOTOR_CT);
-    const float volts = MOTOR_AM * omega * omega + MOTOR_BM * omega + MOTOR_CM;
-    return volts / vbat;   // final clamp to [MIN,MAX]_DUTY by clampDuties()
+    const float omega_sq = thrust / (ETA * CT);
+    const float omega    = std::sqrt(omega_sq);
+    const float drive    = vbat - KE * omega;                  // V - Ke*w [V]
+    if (drive <= 0.0f) return MAX_DUTY;                        // cannot reach this speed
+    const float current_required = (CQ * omega_sq + KT * (I0A + I0B * omega_sq)) / KT;   // [A]
+    const float r_required = drive / current_required;         // [ohm]
+    // R_out decreases with D; entry 1 is D = 0.01 (smallest usable duty), entry 100 is D = 1.
+    // R_out は D とともに減少。要素 1 が D=0.01（最小の有効 duty）、要素 100 が D=1。
+    if (r_required >= ROUT_OHM[1])          return MIN_DUTY;
+    if (r_required <= ROUT_OHM[ROUT_N - 1]) return MAX_DUTY;
+    int lo = 1;
+    int hi = ROUT_N - 1;
+    while (hi - lo > 1) {
+        const int mid = (lo + hi) / 2;
+        if (ROUT_OHM[mid] >= r_required) lo = mid; else hi = mid;
+    }
+    const float frac = (ROUT_OHM[lo] - r_required) / (ROUT_OHM[lo] - ROUT_OHM[lo + 1]);
+    return (static_cast<float>(lo) + frac) * ROUT_STEP;
 }
 
