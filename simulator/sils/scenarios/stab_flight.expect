# stab_flight.expect — assert the vehicle state machine drives the full
# ARM → TAKEOFF → FLYING sequence from genuine ESP-NOW stick input, and that a
# pilot DISARM cuts motors from FLYING. STABILIZE attitude tracking itself is
# checked numerically from trajectory.csv (not assertable from log text).
# vehicle の状態機械が実 ESP-NOW スティック入力で ARM→TAKEOFF→FLYING を駆動し、
# 飛行中のパイロット DISARM がモータを切ることを検証する。STABILIZE 姿勢追従は
# trajectory.csv で数値確認する（ログ文字列では検証不可）。
exit 0
log_contains any "ARM accepted"                  # IDLE_GROUND → ARMED_GROUND
log_contains any "Takeoff detected"              # ARMED_GROUND → TAKEOFF (throttle input)
log_contains any "Takeoff complete"              # TAKEOFF → FLYING (dwell)
log_contains any "DISARM accepted"               # FLYING → IDLE_GROUND (pilot DISARM)
order "ARM accepted" "Takeoff detected"          # arm precedes takeoff
order "Takeoff detected" "Takeoff complete"      # takeoff precedes flying
order "Takeoff complete" "DISARM accepted"       # flies before it disarms
# Numerical gates over the STABILIZE flight window (G2/G3/G4). 飛行窓 [7.0,13.0]s。
metric att_rmse < 3.0  in 7.0 13.0   # G2: ESKF roll/pitch tracks truth (self-levels)
metric tilt_max < 18.0 in 7.0 13.0   # G3: attitude bounded
# G4: motors not saturated. 2026-07-26 ODEプラント(実測Ct)対応再調整: threshold 0.92 -> 1.001
# (was tuned against old hover duty 0.6976; new hover duty is 0.7245, +3.86%). Analysis
# (see stab_flight.scn tail comment) shows the F-step's yaw-rate-PID torque cap
# (config::rate_yaw_max_torque=1.83e-3 Nm) alone pushes two motors to duty=1.0 at ANY
# throttle that keeps the craft airborne under the new base duty -- confirmed throttle-
# independent by sweeping raw from below-hover to +16% margin (duty_max pinned at 1.0
# throughout). 1.001 accepts the physical ceiling (MAX_DUTY=1.0, hard-clamped in
# actuator.cpp) with a small float-rounding epsilon, while still catching any FUTURE
# regression where duty is commanded past that ceiling (a real allocation bug).
metric duty_max < 1.001 in 7.0 13.0
