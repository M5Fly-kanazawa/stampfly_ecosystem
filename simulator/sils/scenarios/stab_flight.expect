# stab_flight.expect — assert the vehicle state machine drives the full
# ARM → TAKEOFF → FLYING sequence from genuine ESP-NOW stick input, and that a
# pilot DISARM cuts motors from FLYING. STABILIZE attitude tracking itself is
# checked numerically from the run's flight-log bundle (truth.csv/attitude.csv/...)
# (not assertable from log text).
# vehicle の状態機械が実 ESP-NOW スティック入力で ARM→TAKEOFF→FLYING を駆動し、
# 飛行中のパイロット DISARM がモータを切ることを検証する。STABILIZE 姿勢追従は
# 実行結果のフライトログ一式（truth.csv/attitude.csv 等）で数値確認する（ログ文字列では検証不可）。
exit 0
log_contains any "ARM accepted"                  # IDLE_GROUND → ARMED_GROUND
log_contains any "Takeoff detected"              # ARMED_GROUND → TAKEOFF (throttle input)
log_contains any "Takeoff complete"              # TAKEOFF → FLYING (dwell)
log_contains any "DISARM accepted"               # FLYING → IDLE_GROUND (pilot DISARM)
order "ARM accepted" "Takeoff detected"          # arm precedes takeoff
order "Takeoff detected" "Takeoff complete"      # takeoff precedes flying
order "Takeoff complete" "DISARM accepted"       # flies before it disarms
# Numerical gates over the STABILIZE flight window (G2/G3/G4). 飛行窓 [7.0,13.0]s。
metric att_rmse < 0.05236  in 7.0 13.0  # 3.0 deg  # G2: ESKF roll/pitch tracks truth (self-levels)
metric tilt_max < 0.3142 in 7.0 13.0  # 18.0 deg  # G3: attitude bounded
# G4: motors not saturated. Threshold 1.001: analysis
# (see stab_flight.scn tail comment) shows the F-step's yaw-rate-PID torque cap
# (config::rate_yaw_max_torque=1.83e-3 Nm) alone pushes two motors to duty=1.0 at ANY
# throttle that keeps the craft airborne under the ODE plant's base duty (hover duty 0.7245) -- throttle-
# independent, confirmed by sweeping raw from below-hover to +16% margin (duty_max pinned at 1.0
# throughout). A bound of 0.92 is rejected for that reason. 1.001 accepts the physical ceiling (MAX_DUTY=1.0, hard-clamped in
# actuator.cpp) with a small float-rounding epsilon, while still catching any
# regression where duty is commanded past that ceiling (a real allocation bug).
# G4 モータ非飽和。しきい値 1.001: 解析（stab_flight.scn 末尾コメント参照）により、F ステップのヨーレート PID
# トルク上限（config::rate_yaw_max_torque=1.83e-3 Nm）だけで、ODE プラントの基準 duty（ホバー duty 0.7245）で
# 機体を空中に保つどのスロットルでも2モータが duty=1.0 になる — スロットル非依存（raw をホバー未満から
# +16% マージンまで掃引して確認、duty_max は常に 1.0）。そのため 0.92 は不採用。1.001 は物理上限
# （MAX_DUTY=1.0、actuator.cpp でハードクランプ）を浮動小数の丸め余裕つきで許容し、
# 上限を超える duty 指令（実際の配分バグ）は引き続き検出する。
metric duty_max < 1.001 in 7.0 13.0
