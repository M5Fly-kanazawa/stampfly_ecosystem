# modeswitch.expect — Phase-8 in-flight mode-switch gate. G1 state-machine (the three
# mode changes fire in order) + G2 estimate tracking + G3 bounded attitude/altitude
# across both switches + G4 actuator health (numerical, from the run's flight-log
# bundle — truth.csv/attitude.csv/...).
#
# Timeline (absolute): A disarmed 0-4, B ARM 4-5, C take-off 5-7, D ALT_HOLD 7-10,
# D2 roll step 10-10.6, E POS_HOLD 10.6-16.6, F ALT_HOLD 16.6-21.6, G DISARM 21.6-22.6.
# The roll step builds a real lateral drift so POS_HOLD has something to arrest and the
# switches are non-trivial.
#
# modeswitch.expect — Phase-8 飛行中モード切替判定。G1 状態機械（3つのモード変更が順に
# 成立）+ G2 推定追従 + G3 両切替を跨いで姿勢/高度が有界 + G4 アクチュエータ健全（数値、
# 実行結果のフライトログ一式（truth.csv/attitude.csv 等）から）。ロールステップで実横ドリフトを作り、POS_HOLD に止める仕事を与え、
# 切替を非自明にする。
exit 0
log_contains any "ARM accepted"                       # G1: IDLE_GROUND → ARMED_GROUND
log_contains any "Takeoff complete"                   # G1: TAKEOFF → FLYING
log_contains any "Mode change: STABILIZE → ALT_HOLD"  # G1: take-off → ALT_HOLD
log_contains any "Mode change: ALT_HOLD → POS_HOLD"   # G1: ALT → POS (cascade engages)
log_contains any "Mode change: POS_HOLD → ALT_HOLD"   # G1: POS → ALT (cascade releases)
log_contains any "DISARM accepted"                    # G1: FLYING → IDLE_GROUND
order "Mode change: STABILIZE → ALT_HOLD" "Mode change: ALT_HOLD → POS_HOLD"
order "Mode change: ALT_HOLD → POS_HOLD" "Mode change: POS_HOLD → ALT_HOLD"
order "Mode change: POS_HOLD → ALT_HOLD" "DISARM accepted"
metric horizontal_drift_max < 2.0  in 11.0 16.6   # G3: POS_HOLD arrests the drift + holds (bounded, no fly-away)
metric tilt_max < 0.3142  in 10.0 21.6  # 18.0 deg  # G3: attitude bounded across BOTH switches (no tumble)
metric alt_min             > 0.25  in 10.0 21.6   # G3: never sinks/crashes through the switches
# G3: never balloons through the switches (POS→ALT held). Phase C's open-loop STABILIZE
# climb (throttle shared with stab_flight.scn's takeoff) already gains altitude BEFORE
# ALT_HOLD engages, and after the roll-step-induced drift + two mode switches the excursion
# decays slowly. This is a transient, not divergence or instability (duty_max stays well
# under its own gate; the switches are non-trivial via horizontal_drift_max/att_rmse).
# 1.60 m leaves margin over the measured peak while still catching a genuine fly-away.
# G3: 切替を跨いで膨らまない（POS→ALT で保持）。C 相の開ループ STABILIZE 上昇（スロットルは
# stab_flight.scn の離陸と共通）は ALT_HOLD が係合する前にすでに高度を稼ぎ、ロールステップによる
# ドリフトと 2 回のモード切替の後、行き過ぎはゆっくり減衰する。これは過渡であり、発散でも不安定でも
# ない（duty_max は自身の基準を十分下回る。切替が自明でないことは horizontal_drift_max/att_rmse で
# 示される）。1.60 m は実測のピークに余裕を持たせつつ、本当の逸走は検出できる。
metric alt_max             < 1.60  in 10.0 21.6
metric duty_max            < 0.92  in 8.0 21.6    # G4: motors not saturated
metric att_rmse < 0.08727   in 13.0 16.6  # 5.0 deg  # G2: ESKF roll/pitch tracks truth (steady POS_HOLD)
