# battery_emergency_takeoff_climbing_manual.expect — a LANDING that begins while the craft climbs low does not end in the air; the motors stop on the floor
# 低い高さを上昇中に始まる LANDING は空中で終わらない。モータは床の上で止まる
#
exit 0
log_contains any "Battery emergency → LANDING"
log_contains any "Transition: TAKEOFF → LANDING"
log_contains any "Transition: LANDING → IDLE_GROUND"
log_absent any "Landing detected (stalled descent"
log_absent any "Transition: TAKEOFF → IDLE_GROUND"
order "Battery emergency → LANDING" "Transition: LANDING → IDLE_GROUND"
metric duty_max > 0.1 in 6.05 6.3
metric alt_max < 0.05 in 12.0 14.0
metric duty_max < 0.01 in 12.0 14.0
metric descent_speed_max < 0.7 in 5.5 14.0
