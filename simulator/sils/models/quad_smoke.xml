<!--
  SILS P1.0 smoke model — a single rigid body (StampFly-sized box) falling onto
  a ground plane under gravity. Just enough to prove MuJoCo builds, loads a
  model, and steps deterministically on this host.

  SILS P1.0 スモーク用モデル — StampFly 大の剛体ボックス1個が、重力で地面に
  落ちるだけ。MuJoCo がビルドでき、モデルを読み、このホスト上で決定論的に
  ステップできることを示すための最小モデル。

  The full StampFly model (4 rotors, inertia, contact, sensors) comes in P1.2.
  完全な StampFly モデル（4ロータ・慣性・接触・センサ）は P1.2 で作る。
-->
<mujoco model="sils_smoke">
  <option timestep="0.0025" gravity="0 0 -9.81" integrator="RK4"/>

  <worldbody>
    <!-- Ground plane / 地面 -->
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.4 0.4 0.4 1"/>

    <!-- StampFly-sized body: 81.5 x 81.5 x 31 mm, ~36 g -->
    <!-- StampFly 大の機体: 81.5 x 81.5 x 31 mm、約 36 g -->
    <body name="drone" pos="0 0 0.5">
      <freejoint name="root"/>
      <geom name="body" type="box" size="0.0408 0.0408 0.0155" mass="0.036"
            rgba="0.2 0.6 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
