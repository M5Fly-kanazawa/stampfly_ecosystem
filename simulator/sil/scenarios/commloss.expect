# commloss.expect — P2-2 comm-loss failsafe gate. Asserts the full chain:
#   Failsafe.checkCommTimeout() DETECTS the stale CommandSetpoint (link timeout)
#   → publishes COMM_LOST → StateManager responds FLYING → LANDING.
# This is the one failsafe that is cleanly injectable in SIL (stop the rc stream);
# battery low-voltage and impact detection are wired and run via Failsafe.update()
# but their dedicated SIL gates need an emu battery/impact knob (tracked follow-up).
# 通信断フェイルセーフのゲート。チェーン全体を検証: checkCommTimeout() が古い
# CommandSetpoint（リンクタイムアウト）を検出 → COMM_LOST 発報 → StateManager が
# FLYING → LANDING で応答。SIL でクリーンに注入できる唯一の failsafe（rc 停止）。
# 低電圧・衝撃の検出は配線済で update() で動くが、専用ゲートは emu 側 knob が要る（follow-up）。
exit 0
log_contains any "ARM accepted"                # IDLE_GROUND → ARMED_GROUND
log_contains any "Takeoff complete"            # TAKEOFF → FLYING (airborne before the gap)
log_contains any "Comm lost:"                  # Failsafe DETECTED link loss (age > 500 ms)
log_contains any "Comm lost → LANDING"         # StateManager response: FLYING → LANDING
log_contains any "Transition: FLYING → LANDING"  # the state transition itself
order "Takeoff complete" "Comm lost:"          # link loss happens while airborne, not on the ground
order "Comm lost:" "Comm lost → LANDING"       # detection precedes the state response
log_contains any "Autonomous landing engaged"          # controller took over (Landing verb: level + fixed descent)
log_contains any "Transition: LANDING → IDLE_GROUND"   # the craft actually descended and touched down
order "Comm lost → LANDING" "Autonomous landing engaged"          # verb follows the transition
order "Autonomous landing engaged" "Transition: LANDING → IDLE_GROUND"  # descent completes the chain
